@model List<Hospital_Management_UI.Models.Doctor>

<h2>Doctors</h2>

<a asp-action="Create" class="btn btn-primary mb-2">Add Doctor</a>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Specialization</th>
        <th>Department</th>
        <th>Email</th>
        <th>Action</th>
    </tr>

    @foreach (var d in Model)
    {
        <tr>
            <td>@d.Id</td>
            <td>@d.FullName</td>
            <td>@d.Specialization</td>
            <td>@d.Department</td>
            <td>@d.Email</td>
            <td>
                <a asp-action="Edit" asp-route-id="@d.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@d.Id">Delete</a>
            </td>
        </tr>
    }
</table>
